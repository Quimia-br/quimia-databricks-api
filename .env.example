# Copie para .env e preencha. O .env real NUNCA vai para o git.

DATABASE_URL=postgres://usuario:senha@host:porta/quimia_analytics?sslmode=require

# Chave que a aplicação web envia no header X-API-Key
API_KEY=

# Validade do cache em segundos (a gold só muda quando o Job roda)
CACHE_TTL=3600

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000
